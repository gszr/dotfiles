# vim: filetype=zsh
# utilities

# --- OS detection ---

function os_name {
  uname -s
}

function is_macos {
  [[ "$(os_name)" == "Darwin" ]]
}

function is_linux {
  [[ "$(os_name)" == "Linux" ]]
}

function is_netbsd {
  [[ "$(os_name)" == "NetBSD" ]]
}

# --- Command availability ---

function has_cmd {
  hash "$1" &> /dev/null
}

# --- PATH helpers ---

function path_prepend {
  [[ -d "$1" ]] && export PATH="$1:$PATH"
}

function path_append {
  [[ -d "$1" ]] && export PATH="$PATH:$1"
}

# --- Tool initialization ---
# Usage: init_tool_env <tool_name> [extra_args...]
# e.g. init_tool_env rbenv
#      init_tool_env pyenv

function init_tool_env {
  local tool="$1"
  shift
  if has_cmd "$tool"; then
    eval "$($tool init - $@)"
  fi
}

# --- Retry ---

# adapted from https://gist.github.com/felipou/6fbec22c4e04d3adfae5
function retry {
  local sleep=30
  local retry=10

  while [[ $# -gt 1 ]]; do
    key=$1
    case $key in
      -s|--sleep)
        sleep=$2
        shift
        ;;
      -r|--retries)
        retry=$2
        shift
        ;;
    esac
    shift
  done

  local cmd="$@"
  local cnt=1

  eval $cmd

  while [[ $? -ne 0 ]] && [[ $cnt -lt $retry ]]; do
    echo "Command failed. Retrying in $sleep seconds..."
    sleep $sleep
    cnt=$(($cnt + 1))
    eval $cmd
  done

  if [[ $cnt -eq $retry ]]; then
    echo "Max retries reached; giving up."
  fi
}

function tainted() {
  for i in $(seq 18); do echo $(($i-1)) $(($(cat /proc/sys/kernel/tainted)>>($i-1)&1));done
}
